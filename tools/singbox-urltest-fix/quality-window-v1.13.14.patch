diff --git a/protocol/group/urltest_quality.go b/protocol/group/urltest_quality.go
new file mode 100644
index 00000000..47004b9a
--- /dev/null
+++ b/protocol/group/urltest_quality.go
@@ -0,0 +1,124 @@
+package group
+
+import (
+	"sort"
+	"sync"
+	"time"
+)
+
+const (
+	urlTestQualityWindowSize        = 5
+	urlTestQualityFailurePenalty    = 1000
+	urlTestQualityFailureThreshold  = 2
+	urlTestQualityRecoveryThreshold = 3
+)
+
+type urlTestQualitySample struct {
+	delay   uint16
+	success bool
+}
+
+type urlTestQualityState struct {
+	samples              []urlTestQualitySample
+	consecutiveFailures  int
+	consecutiveSuccesses int
+	quarantined          bool
+	updatedAt            time.Time
+}
+
+type urlTestQualityTracker struct {
+	access sync.Mutex
+	states map[string]*urlTestQualityState
+}
+
+func newURLTestQualityTracker() *urlTestQualityTracker {
+	return &urlTestQualityTracker{states: make(map[string]*urlTestQualityState)}
+}
+
+func (t *urlTestQualityTracker) recordSuccess(tag string, delay uint16) {
+	if delay == 0 {
+		delay = 1
+	}
+	t.access.Lock()
+	defer t.access.Unlock()
+	state := t.state(tag)
+	state.append(urlTestQualitySample{delay: delay, success: true})
+	state.updatedAt = time.Now()
+	state.consecutiveFailures = 0
+	state.consecutiveSuccesses++
+	if state.quarantined && state.consecutiveSuccesses >= urlTestQualityRecoveryThreshold {
+		state.quarantined = false
+	}
+}
+
+func (t *urlTestQualityTracker) recordFailure(tag string) {
+	t.access.Lock()
+	defer t.access.Unlock()
+	state := t.state(tag)
+	state.append(urlTestQualitySample{})
+	state.updatedAt = time.Now()
+	state.consecutiveSuccesses = 0
+	state.consecutiveFailures++
+	if state.consecutiveFailures >= urlTestQualityFailureThreshold {
+		state.quarantined = true
+	}
+}
+
+func (t *urlTestQualityTracker) fresh(tag string, interval time.Duration) bool {
+	t.access.Lock()
+	defer t.access.Unlock()
+	state := t.states[tag]
+	return state != nil && !state.updatedAt.IsZero() && time.Since(state.updatedAt) < interval
+}
+
+func (t *urlTestQualityTracker) score(tag string) (score uint16, available bool, loaded bool) {
+	t.access.Lock()
+	defer t.access.Unlock()
+	state, loaded := t.states[tag]
+	if !loaded {
+		return 0, false, false
+	}
+	if state.quarantined {
+		return 0, false, true
+	}
+	delays := make([]uint16, 0, len(state.samples))
+	failures := 0
+	for _, sample := range state.samples {
+		if sample.success {
+			delays = append(delays, sample.delay)
+		} else {
+			failures++
+		}
+	}
+	if len(delays) == 0 {
+		return 0, false, true
+	}
+	sort.Slice(delays, func(i, j int) bool { return delays[i] < delays[j] })
+	median := uint32(delays[len(delays)/2])
+	if len(delays)%2 == 0 {
+		median = (uint32(delays[len(delays)/2-1]) + median) / 2
+	}
+	tail := uint32(delays[len(delays)-1])
+	qualityScore := median + 2*(tail-median) + uint32(failures*urlTestQualityFailurePenalty)
+	if qualityScore > uint32(^uint16(0)) {
+		qualityScore = uint32(^uint16(0))
+	}
+	return uint16(qualityScore), true, true
+}
+
+func (t *urlTestQualityTracker) state(tag string) *urlTestQualityState {
+	state := t.states[tag]
+	if state == nil {
+		state = new(urlTestQualityState)
+		t.states[tag] = state
+	}
+	return state
+}
+
+func (s *urlTestQualityState) append(sample urlTestQualitySample) {
+	s.samples = append(s.samples, sample)
+	if len(s.samples) > urlTestQualityWindowSize {
+		copy(s.samples, s.samples[len(s.samples)-urlTestQualityWindowSize:])
+		s.samples = s.samples[:urlTestQualityWindowSize]
+	}
+}
diff --git a/protocol/group/urltest_quality_test.go b/protocol/group/urltest_quality_test.go
new file mode 100644
index 00000000..ef42ac09
--- /dev/null
+++ b/protocol/group/urltest_quality_test.go
@@ -0,0 +1,83 @@
+package group
+
+import (
+	"testing"
+	"time"
+)
+
+func TestURLTestQualityStableScore(t *testing.T) {
+	tracker := newURLTestQualityTracker()
+	for _, delay := range []uint16{100, 110, 90, 105, 95} {
+		tracker.recordSuccess("stable", delay)
+	}
+	score, available, loaded := tracker.score("stable")
+	if !loaded || !available {
+		t.Fatal("stable node should be available")
+	}
+	if score != 120 {
+		t.Fatalf("unexpected stable score: %d", score)
+	}
+}
+
+func TestURLTestQualityPenalizesJitter(t *testing.T) {
+	tracker := newURLTestQualityTracker()
+	for _, delay := range []uint16{100, 105, 100, 500, 100} {
+		tracker.recordSuccess("jitter", delay)
+	}
+	score, available, _ := tracker.score("jitter")
+	if !available {
+		t.Fatal("jittery node should remain available")
+	}
+	if score != 900 {
+		t.Fatalf("unexpected jitter score: %d", score)
+	}
+}
+
+func TestURLTestQualityRollingWindow(t *testing.T) {
+	tracker := newURLTestQualityTracker()
+	tracker.recordSuccess("rolling", 1000)
+	for range urlTestQualityWindowSize {
+		tracker.recordSuccess("rolling", 100)
+	}
+	score, available, _ := tracker.score("rolling")
+	if !available || score != 100 {
+		t.Fatalf("old sample should leave rolling window, score=%d available=%v", score, available)
+	}
+}
+
+func TestURLTestQualityQuarantineAndRecovery(t *testing.T) {
+	tracker := newURLTestQualityTracker()
+	tracker.recordSuccess("flaky", 100)
+	tracker.recordFailure("flaky")
+	score, available, _ := tracker.score("flaky")
+	if !available || score != 1100 {
+		t.Fatalf("one failure should penalize without quarantine, score=%d available=%v", score, available)
+	}
+	tracker.recordFailure("flaky")
+	if _, available, _ = tracker.score("flaky"); available {
+		t.Fatal("two consecutive failures should quarantine")
+	}
+	tracker.recordSuccess("flaky", 90)
+	tracker.recordSuccess("flaky", 95)
+	if _, available, _ = tracker.score("flaky"); available {
+		t.Fatal("quarantine should require three consecutive successes")
+	}
+	tracker.recordSuccess("flaky", 100)
+	if _, available, _ = tracker.score("flaky"); !available {
+		t.Fatal("three consecutive successes should recover")
+	}
+}
+
+func TestURLTestQualityMissingState(t *testing.T) {
+	tracker := newURLTestQualityTracker()
+	if _, available, loaded := tracker.score("missing"); loaded || available {
+		t.Fatal("missing state should fall back to raw URLTest history")
+	}
+	if tracker.fresh("missing", time.Minute) {
+		t.Fatal("missing state should not be fresh")
+	}
+	tracker.recordSuccess("present", 100)
+	if !tracker.fresh("present", time.Minute) {
+		t.Fatal("new quality sample should be fresh")
+	}
+}
